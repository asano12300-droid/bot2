#!/bin/bash

help () {
	echo "+-----help-------------------------+"
        echo "| commands:                        |"
	echo "|    reload      : daemon-reload   |"
        echo "|  --restart, -r : restart (system)|"
        echo "|  --status, -s  : status (system) |"
	echo "|  --help, -h    : help menu       |"
	echo "+----------------------------------+"
	echo "|                                  |"
}

if [ "$1" = "reload" ]; then
	sudo systemctl daemon-reload
elif [[ "$1" == "--restart" || "$1" == "-r" ]]; then
	if [ -z "$2"]; then
		sudo systemctl restart bot1
		sudo systemctl restart bot2
        else
		sudo systemctl restart $2
		sudo systemctl status $2
	fi
elif [[ "$1" == "--status" || "$1" == "-s" ]]; then
	sudo systemctl status $2
elif [[ "$1" == "--help" || "$1" == "-h" || -z "$1" ]]; then
	help
fi
